{
	"version": 10,
	"include": [
		"../common/CMakePresets.json"
	],
	"configurePresets": [
		{
			"name": "windows-default",
			"hidden": true,
			"description": "Base preset for Windows identities",
			"inherits": [
				"default"
			],
"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			},
			"cacheVariables": {
				"CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "${sourceDir}/tool/cmake/platform/common/SetMSVCRuntime.cmake;${sourceDir}/tool/cmake/dependencies.cmake",
				"CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "$<$<CONFIG:Debug,Development>:ProgramDatabase>"
			}
		},
		{
			"name": "windows-default-development",
			"hidden": true,
			"description": "Development configuration: optimized with debug info and assertions, Release ABI and dependencies",
			"cacheVariables": {
				"CMAKE_C_FLAGS_DEVELOPMENT": "/O2 /Ob2",
				"CMAKE_CXX_FLAGS_DEVELOPMENT": "/O2 /Ob2",
				"CMAKE_EXE_LINKER_FLAGS_DEVELOPMENT": "/DEBUG /INCREMENTAL:NO /OPT:REF /OPT:ICF",
				"CMAKE_SHARED_LINKER_FLAGS_DEVELOPMENT": "/DEBUG /INCREMENTAL:NO /OPT:REF /OPT:ICF",
				"CMAKE_MODULE_LINKER_FLAGS_DEVELOPMENT": "/DEBUG /INCREMENTAL:NO /OPT:REF /OPT:ICF",
				"CMAKE_MAP_IMPORTED_CONFIG_DEVELOPMENT": "Release"
			}
		},
		{
			"name": "windows-x64-msvc-toolchain",
			"hidden": true,
			"description": "Compiler and flags for Windows x64 MSVC",
			"inherits": [
				"windows-default"
			],
			"architecture": {
				"value": "x64",
				"strategy": "external"
			},
			"cacheVariables": {
				"SYNODIC_BUILD_IDENTITY": "windows-x64-msvc",
				"CMAKE_C_COMPILER": "cl",
				"CMAKE_CXX_COMPILER": "cl",
				"CMAKE_C_FLAGS_INIT": "/W4",
				"CMAKE_CXX_FLAGS_INIT": "/W4"
			},
			"vendor": {
				"microsoft.com/VisualStudioSettings/CMake/1.0": {
					"intelliSenseMode": "windows-msvc-x64"
				}
			}
		},
		{
			"name": "windows-x64-msvc",
			"displayName": "Windows x64 MSVC",
			"description": "Ninja Multi-Config: choose Debug, Development, or Release when building",
			"generator": "Ninja Multi-Config",
			"binaryDir": "${sourceDir}/build/windows-x64-msvc/multi",
			"inherits": [
				"windows-x64-msvc-toolchain",
				"windows-default-development"
			],
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": "Debug;Development;Release"
			}
		},
		{
			"name": "windows-x64-msvc-debug",
			"displayName": "Windows x64 MSVC Debug",
			"description": "Ninja single-config Debug build",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/windows-x64-msvc/debug",
			"inherits": [
				"windows-x64-msvc-toolchain"
			],
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "windows-x64-msvc-development",
			"displayName": "Windows x64 MSVC Development",
			"description": "Ninja single-config Development build",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/windows-x64-msvc/development",
			"inherits": [
				"windows-x64-msvc-toolchain",
				"windows-default-development"
			],
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Development"
			}
		},
		{
			"name": "windows-x64-msvc-release",
			"displayName": "Windows x64 MSVC Release",
			"description": "Ninja single-config Release build",
			"generator": "Ninja",
