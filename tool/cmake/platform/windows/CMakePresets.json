{
	"version": 9,
	"include": [
		"../common/CMakePresets.json"
	],
	"configurePresets": [
		{
			"name": "windows-default",
			"inherits": [
				"default"
			],
			"hidden": true,
			"description": "Base preset for Windows configurations",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			},
			"cacheVariables": {
				"CMAKE_C_FLAGS_INIT": "/W4",
				"CMAKE_CXX_FLAGS_INIT": "/W4",
				"CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "${sourceDir}/tool/cmake/platform/common/SetMSVCRuntime.cmake"
			}
		},
		{
			"name": "windows-ninja-msvc",
			"displayName": "Ninja - MSVC",
			"description": "Ninja Multi-Config generator with Microsoft Visual C++ (MSVC)",
			"generator": "Ninja Multi-Config",
			"inherits": [
				"windows-default"
			],
			"cacheVariables": {
				"CMAKE_C_COMPILER": "cl",
				"CMAKE_CXX_COMPILER": "cl"
			}
		},
		{
			"name": "windows-ninja-clang",
			"displayName": "Ninja - Clang",
			"description": "Ninja Multi-Config generator with Clang (clang-cl)",
			"generator": "Ninja Multi-Config",
			"inherits": [
				"windows-default"
			],
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang-cl",
				"CMAKE_CXX_COMPILER": "clang-cl"
			}
		},
		{
			"name": "windows-msbuild-msvc",
			"displayName": "MSBuild - MSVC",
			"description": "Visual Studio 18 2026 generator with Microsoft Visual C++ (MSVC)",
			"generator": "Visual Studio 18 2026",
			"architecture": {
				"value": "x64",
				"strategy": "set"
			},
			"inherits": [
				"windows-default"
			],
			"cacheVariables": {
				"CMAKE_C_COMPILER": "cl",
				"CMAKE_CXX_COMPILER": "cl"
			}
		},
		{
			"name": "windows-msbuild-clang",
			"displayName": "MSBuild - Clang",
			"description": "Visual Studio 18 2022 generator with Clang (clang-cl)",
			"generator": "Visual Studio 18 2026",
			"architecture": {
				"value": "x64",
				"strategy": "set"
			},
			"inherits": [
				"windows-default"
			],
			"cacheVariables": {
				"CMAKE_C_COMPILER": "clang-cl",
				"CMAKE_CXX_COMPILER": "clang-cl"
			},
			"toolset": "ClangCL"
		},
		{
			"name": "windows-msbuild-msvc-release",
			"inherits": [
				"cppython-release",
				"windows-msbuild-msvc"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Release"
				}
			}
		},
		{
			"name": "windows-msbuild-msvc-development",
			"inherits": [
				"cppython-release",
				"windows-msbuild-msvc"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Development"
				},
				"CMAKE_MAP_IMPORTED_CONFIG_DEVELOPMENT": {
					"type": "STRING",
					"value": "Release"
				}
			}
		},
		{
			"name": "windows-msbuild-msvc-debug",
			"inherits": [
				"cppython-debug",
				"windows-msbuild-msvc"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Debug"
				}
			}
		},
		{
			"name": "windows-ninja-clang-release",
			"inherits": [
				"cppython-release",
				"windows-ninja-clang"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Release"
				}
			}
		},
		{
			"name": "windows-ninja-clang-development",
			"inherits": [
				"cppython-release",
				"windows-ninja-clang"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Development"
				},
				"CMAKE_MAP_IMPORTED_CONFIG_DEVELOPMENT": {
					"type": "STRING",
					"value": "Release"
				}
			}
		},
		{
			"name": "windows-ninja-clang-debug",
			"inherits": [
				"cppython-debug",
				"windows-ninja-clang"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Debug"
				}
			}
		},
		{
			"name": "windows-ninja-msvc-release",
			"inherits": [
				"cppython-release",
				"windows-ninja-msvc"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Release"
				}
			}
		},
		{
			"name": "windows-ninja-msvc-development",
			"inherits": [
				"cppython-release",
				"windows-ninja-msvc"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Development"
				},
				"CMAKE_MAP_IMPORTED_CONFIG_DEVELOPMENT": {
					"type": "STRING",
					"value": "Release"
				}
			}
		},
		{
			"name": "windows-ninja-msvc-debug",
			"inherits": [
				"cppython-debug",
				"windows-ninja-msvc"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": {
					"type": "STRING",
					"value": "Debug"
				}
			}
		}
	],
	"buildPresets": [
		{
			"name": "windows-default",
			"hidden": true,
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		},
		{
			"name": "windows-ninja-msvc-release",
			"displayName": "Ninja MSVC Release",
			"configurePreset": "windows-ninja-msvc-release",
			"configuration": "Release",
			"inherits": [
				"windows-default"
			]
		},
		{
			"name": "windows-ninja-msvc-development",
			"displayName": "Ninja MSVC Development",
			"configurePreset": "windows-ninja-msvc-development",
			"configuration": "Development",
			"inherits": [
				"windows-default"
			]
		},
		{
			"name": "windows-ninja-msvc-debug",
			"displayName": "Ninja MSVC Debug",
			"configurePreset": "windows-ninja-msvc-debug",
			"configuration": "Debug",
			"inherits": [
				"windows-default"
			]
		},
		{
			"name": "windows-msbuild-msvc-release",
			"displayName": "Release",
			"configurePreset": "windows-msbuild-msvc-release",
			"configuration": "Release",
			"inherits": [
				"windows-default"
			]
		},
		{
			"name": "windows-msbuild-msvc-development",
			"displayName": "Development",
			"configurePreset": "windows-msbuild-msvc-development",
			"configuration": "Development",
			"inherits": [
				"windows-default"
			]
		},
		{
			"name": "windows-msbuild-msvc-debug",
			"displayName": "Debug",
			"configurePreset": "windows-msbuild-msvc-debug",
			"configuration": "Debug",
			"inherits": [
				"windows-default"
			]
		},
		{
			"name": "windows-ninja-clang-release",
			"displayName": "Release",
			"configurePreset": "windows-ninja-clang-release",
			"configuration": "Release",
			"inherits": [
				"windows-default"
			]
		},
		{
			"name": "windows-ninja-clang-development",
			"displayName": "Development",
			"configurePreset": "windows-ninja-clang-development",
			"configuration": "Development",
			"inherits": [
				"windows-default"
			]
		},
		{
			"name": "windows-ninja-clang-debug",
			"displayName": "Debug",
			"configurePreset": "windows-ninja-clang-debug",
			"configuration": "Debug",
			"inherits": [
				"windows-default"
			]
		}
	],
	"testPresets": [
		{
			"name": "windows-default",
			"hidden": true,
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			},
			"inherits": [
				"default"
			]
		},
		{
			"name": "windows-msbuild-msvc-test-debug",
			"displayName": "Test Debug Configuration",
			"configurePreset": "windows-msbuild-msvc-debug",
			"inherits": [
				"windows-default"
			],
			"configuration": "Debug"
		},
		{
			"name": "windows-ninja-msvc-debug",
			"displayName": "Ninja MSVC Debug",
			"configurePreset": "windows-ninja-msvc-debug",
			"inherits": [
				"windows-default"
			],
			"configuration": "Debug"
		},
		{
			"name": "windows-ninja-msvc-release",
			"displayName": "Ninja MSVC Release",
			"configurePreset": "windows-ninja-msvc-release",
			"inherits": [
				"windows-default"
			],
			"configuration": "Release"
		}
	]
}
