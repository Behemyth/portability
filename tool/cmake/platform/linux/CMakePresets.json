{
	"version": 10,
	"include": [
		"../common/CMakePresets.json"
	],
	"configurePresets": [
		{
			"name": "linux-default",
			"hidden": true,
			"description": "Base preset for Linux identities",
			"inherits": [
				"default"
			],
"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			},
			"cacheVariables": {
				"CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "${sourceDir}/tool/cmake/dependencies.cmake"
			}
		},
		{
			"name": "linux-default-development",
			"hidden": true,
			"description": "Development configuration: optimized with debug info and assertions, Release ABI and dependencies",
			"cacheVariables": {
				"CMAKE_C_FLAGS_DEVELOPMENT": "-O2 -g",
				"CMAKE_CXX_FLAGS_DEVELOPMENT": "-O2 -g -D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_EXTENSIVE",
				"CMAKE_MAP_IMPORTED_CONFIG_DEVELOPMENT": "Release"
			}
		},
		{
			"name": "linux-x64-clang-libcxx-toolchain",
			"hidden": true,
			"description": "Compiler and flags for Linux x64 Clang libc++",
			"inherits": [
				"linux-default"
			],
			"cacheVariables": {
				"SYNODIC_BUILD_IDENTITY": "linux-x64-clang-libcxx",
				"CMAKE_C_COMPILER": "clang",
				"CMAKE_CXX_COMPILER": "clang++",
				"CMAKE_C_FLAGS_INIT": "-Wall -Wextra -Wpedantic",
				"CMAKE_CXX_FLAGS_INIT": "-Wall -Wextra -Wpedantic -stdlib=libc++",
				"CMAKE_EXE_LINKER_FLAGS_INIT": "-stdlib=libc++",
				"CMAKE_SHARED_LINKER_FLAGS_INIT": "-stdlib=libc++",
				"CMAKE_MODULE_LINKER_FLAGS_INIT": "-stdlib=libc++"
			},
			"vendor": {
				"microsoft.com/VisualStudioSettings/CMake/1.0": {
					"intelliSenseMode": "linux-clang-x64"
				}
			}
		},
		{
			"name": "linux-x64-clang-libcxx",
			"displayName": "Linux x64 Clang libc++",
			"description": "Ninja Multi-Config: choose Debug, Development, or Release when building",
			"generator": "Ninja Multi-Config",
			"binaryDir": "${sourceDir}/build/linux-x64-clang-libcxx/multi",
			"inherits": [
				"linux-x64-clang-libcxx-toolchain",
				"linux-default-development"
			],
			"cacheVariables": {
				"CMAKE_CONFIGURATION_TYPES": "Debug;Development;Release"
			}
		},
		{
			"name": "linux-x64-clang-libcxx-debug",
			"displayName": "Linux x64 Clang libc++ Debug",
			"description": "Ninja single-config Debug build",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/linux-x64-clang-libcxx/debug",
