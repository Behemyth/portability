			"inherits": [
				"linux-default"
			],
			"cacheVariables": {
				"SYNODIC_BUILD_IDENTITY": "linux-x64-clang-libcxx-sanitize",
				"CMAKE_C_COMPILER": "clang",
				"CMAKE_CXX_COMPILER": "clang++",
				"CMAKE_C_FLAGS_INIT": "-Wall -Wextra -Wpedantic -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
